NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/croco_flag

# Auth
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY_SECONDS=86400
BCRYPT_ROUNDS=10

# Docker Support
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=croco_flag
POSTGRES_PORT=5432
REDIS_PORT=6379
